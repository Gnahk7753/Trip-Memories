# Chuỗi kết nối Neon (Console > Connection Details > chọn "Pooled connection"), bắt buộc có sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Chuỗi bí mật ký JWT (tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai

# Cloudinary (Dashboard > API Keys > API environment variable) - lưu ảnh/video/QR
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# (Tuỳ chọn) Mã mời: nếu đặt, người đăng ký phải nhập đúng mã => app thật sự "nội bộ"
INVITE_CODE=

# Render tự cấp PORT; chạy local dùng 3000
PORT=3000
